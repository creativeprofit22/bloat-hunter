[
  {
    "id": "browser.edge.cache",
    "name": "Edge Cache",
    "description": "Cached web content (pages, images, scripts) — regenerated automatically",
    "risk": "green",
    "paths": [
      {
        "path": "$$PROFILE$$\\Cache\\Cache_Data",
        "pattern": "*",
        "search": "files",
        "recursive": false
      },
      { "path": "$$PROFILE$$\\Cache", "pattern": "*", "search": "files", "recursive": false }
    ]
  },
  {
    "id": "browser.edge.code-cache",
    "name": "Edge Code Cache",
    "description": "Cached compiled JavaScript and WebAssembly — regenerated automatically",
    "risk": "green",
    "paths": [
      {
        "path": "$$PROFILE$$\\Code Cache",
        "pattern": "*",
        "search": "both",
        "recursive": true,
        "maxDepth": 3
      }
    ]
  },
  {
    "id": "browser.edge.gpu-cache",
    "name": "Edge GPU/Shader Cache",
    "description": "Cached GPU shader programs and graphics data — regenerated automatically",
    "risk": "green",
    "paths": [
      {
        "path": "$$PROFILE$$\\GPUCache",
        "pattern": "*",
        "search": "both",
        "recursive": true,
        "maxDepth": 3
      },
      {
        "path": "$$PROFILE$$\\ShaderCache",
        "pattern": "*",
        "search": "both",
        "recursive": true,
        "maxDepth": 3
      }
    ]
  },
  {
    "id": "browser.edge.service-workers",
    "name": "Edge Service Workers",
    "description": "Cached service worker scripts and data — regenerated by websites automatically",
    "risk": "green",
    "paths": [
      {
        "path": "$$PROFILE$$\\Service Worker",
        "pattern": "*",
        "search": "both",
        "recursive": true,
        "maxDepth": 5
      }
    ]
  },
  {
    "id": "browser.edge.cookies",
    "name": "Edge Cookies",
    "description": "Website cookies — deleting will sign you out of all websites",
    "risk": "yellow",
    "paths": [
      { "path": "$$PROFILE$$", "pattern": "Cookies", "search": "files", "recursive": false },
      { "path": "$$PROFILE$$", "pattern": "Cookies-journal", "search": "files", "recursive": false }
    ]
  },
  {
    "id": "browser.edge.history",
    "name": "Edge History",
    "description": "Browsing history and visited URLs — cannot be recovered once deleted",
    "risk": "yellow",
    "paths": [
      { "path": "$$PROFILE$$", "pattern": "History", "search": "files", "recursive": false },
      {
        "path": "$$PROFILE$$",
        "pattern": "History-journal",
        "search": "files",
        "recursive": false
      },
      { "path": "$$PROFILE$$", "pattern": "Visited Links", "search": "files", "recursive": false }
    ]
  },
  {
    "id": "browser.edge.session",
    "name": "Edge Session Data",
    "description": "Current and recent browser sessions — open tabs will not be restorable",
    "risk": "yellow",
    "paths": [
      { "path": "$$PROFILE$$\\Sessions", "pattern": "*", "search": "files", "recursive": false },
      {
        "path": "$$PROFILE$$",
        "pattern": "Current Session",
        "search": "files",
        "recursive": false
      },
      { "path": "$$PROFILE$$", "pattern": "Current Tabs", "search": "files", "recursive": false },
      { "path": "$$PROFILE$$", "pattern": "Last Session", "search": "files", "recursive": false },
      { "path": "$$PROFILE$$", "pattern": "Last Tabs", "search": "files", "recursive": false }
    ]
  },
  {
    "id": "browser.edge.dom-storage",
    "name": "Edge DOM Storage",
    "description": "Website local storage and IndexedDB — may contain login tokens and saved preferences",
    "risk": "yellow",
    "paths": [
      {
        "path": "$$PROFILE$$\\Local Storage",
        "pattern": "*",
        "search": "both",
        "recursive": true,
        "maxDepth": 3
      },
      {
        "path": "$$PROFILE$$\\IndexedDB",
        "pattern": "*",
        "search": "both",
        "recursive": true,
        "maxDepth": 5
      }
    ]
  }
]
